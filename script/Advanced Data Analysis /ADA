)

SELECT
customer_segments,
COUNT(customer_key)
FROM (
SELECT 
customer_key,
CASE WHEN time_span>=12 AND total_spending>5000 THEN 'VIP'
	 WHEN time_span>=12 AND total_spending<=5000 THEN 'Regular'
	 ELSE 'New'
END customer_segments
FROM grouping_timespan
)t
GROUP BY customer_segments

/*
======================================================================================================
                                           Customer Report
======================================================================================================
Purpose:
	- This report consolidates key customer metrics and behaviours
	
Highlights:
	1. Gathering essential fields such as names, ages, and transaction details.
	3. Segmenting customers into categories (VIP, Regular, New) and age groups.
	2. Aggregating customer-level metrics:
	   - total orders, total sales, total quantity purchased, total products, lifespan (in months)
	4. Calculculates valuable KPIs:
	   - recency (months since last order) 
	   - average order value
	   - average monthly spend
======================================================================================================
*/
CREATE VIEW gold.report_customers AS
/*----------------------------------------------------------------------------------------------------
                         1. Base Query: Retrieves core columns from tables
----------------------------------------------------------------------------------------------------*/
WITH base_query AS(
SELECT 
f.order_number,
f.product_key,
f.order_date,
f.sales_amount,
f.quantity,
c.customer_key,
c.customer_number,
CONCAT(c.first_name, ' ', c.last_name) AS customer_name,
DATEDIFF(year, c.birth_date, GETDATE()) AS customer_age
FROM gold.fact_sales f 
LEFT JOIN gold.dim_customer c
ON f.customer_key = c.customer_key
WHERE order_date IS NOT NULL
)

/*----------------------------------------------------------------------------------------------------
                                  2. Aggregating customer-leve metrics
----------------------------------------------------------------------------------------------------*/
, customer_aggregation AS (
--2) Aggregating customer-leve metrics
SELECT
	customer_key,
	customer_number, 
	customer_name,
	customer_age,
	COUNT(DISTINCT order_number) AS total_orders,
	SUM(sales_amount) AS total_spending,
	SUM(quantity) AS total_quantity,
	COUNT(DISTINCT(product_key)) AS total_products,
	MAX(order_date) AS last_order,
	DATEDIFF(MONTH, MIN(order_date), MAX(order_date)) AS time_span
FROM base_query
GROUP BY 
	customer_key,
	customer_number, 
	customer_name,
	customer_age
	)
/*----------------------------------------------------------------------------------------------------
             3. Segmenting customers into categories (VIP, Regular, New) and age groups
			 4. Calculculates valuable KPIs
----------------------------------------------------------------------------------------------------*/
SELECT 
	customer_key,
	customer_number, 
	customer_name,
	customer_age,
	CASE WHEN customer_age < 25 THEN 'Under 25'
		 WHEN customer_age >= 25 AND customer_age < 35 THEN '25-35'
	     WHEN customer_age >= 35 AND customer_age <= 45 THEN '35-45'
		 ELSE 'Above 45'
	END age_group,
	total_orders,
	total_quantity,
	total_products,
	total_spending,
	CASE WHEN time_span>=12 AND total_spending>5000 THEN 'VIP'
	     WHEN time_span>=12 AND total_spending<=5000 THEN 'Regular'
	     ELSE 'New'
    END customer_segments,
	last_order,
	DATEDIFF(MONTH, last_order, GETDATE()) AS recency,
	-- Calculating average order value:
	CASE WHEN total_spending=0 then 0
	     ELSE total_spending/total_orders
	END AS average_order_value,
	-- Calculating average monthly spend
	CASE WHEN time_span = 0 then 0
	ELSE total_spending/time_span
	END AS average_monthly_spend
FROM customer_aggregation

SELECT * FROM gold.report_customers

 /*
======================================================================================================
                                           Product Report
======================================================================================================
Purpose:
	- This report consolidates key product metrics and behaviours
	
Highlights:
	1. Gathering essential fields such as product name, category, subcategory, and cost.
	3. Segmenting products by revenu to identify High_Performancers, Mid_Range, or Low_Performancers.
	2. Aggregating product-level metrics:
	   - total orders, total sales, total quantity sold, total customers(unique), lifespan (in months)
	4. Calculculates valuable KPIs:
	   - recency (months since last order) 
	   - average order revenue
	   - average monthly spend
======================================================================================================
*/
CREATE VIEW gold.report_products AS
/*----------------------------------------------------------------------------------------------------
                          1. Base Query: Retrieves core columns form tables
----------------------------------------------------------------------------------------------------*/
WITH base_query AS (
SELECT 
	p.product_key,
	p.product_number,
	p.product_name,
	p.category,
	p.subcategory,
	p.cost, 
	f.order_number,
	f.order_date,
	f.sales_amount,
	f.quantity,
	f.customer_key
FROM 
	gold.dim_products p
LEFT JOIN 
	gold.fact_sales f
ON 
	f.product_key = p.product_key
WHERE order_date IS NOT NULL
)

/*----------------------------------------------------------------------------------------------------
                                  2. Aggregating product-level metrics
----------------------------------------------------------------------------------------------------*/
, product_aggregation AS (
SELECT
	product_key,
	product_name,
	category,
	subcategory,
	cost,
	COUNT(DISTINCT order_number) AS total_orders,
	SUM(sales_amount) AS total_sales,
	SUM(quantity) AS total_quantity,
	COUNT(DISTINCT(customer_key)) AS total_customers,
	MAX(order_date) AS last_order,
	DATEDIFF(MONTH, MIN(order_date), MAX(order_date)) AS time_span,
	ROUND(AVG(CAST(sales_amount AS FLOAT)/NULLIF(quantity, 0)), 1) AS average_selling_price
FROM base_query
GROUP BY 
	product_key,
	product_name,
	category,
	subcategory,
	cost
)

/*----------------------------------------------------------------------------------------------------
    3. Segmenting products by revenu to identify High_Performancers, Mid_Range, or Low_Performancers.
	4. Calculculating valuable KPIs
----------------------------------------------------------------------------------------------------*/
SELECT 
	product_key, 
	product_name,
	category,
	subcategory,
	cost,
	total_sales,
	CASE WHEN total_sales>50000 THEN 'High-Performancers'
	     WHEN total_sales>=10000 THEN 'Mid-Ranger'
		 ELSE 'Low-Performancer'
	END AS product_segment,
	
	time_span,
	total_orders,
	total_quantity,
	total_customers,
	average_selling_price,
	last_order,

	-- recency (months since last order)
	DATEDIFF(MONTH, last_order, GETDATE()) AS recency_month,

	-- average order revenue
	CASE WHEN total_orders = 0 THEN 0
	     ELSE total_sales/total_orders 
	END AS average_order_revenue,

	-- average monthly spend
	CASE WHEN time_span=0 THEN 0
		 ELSE total_sales/time_span
	END AS average_monthly_spend

FROM product_aggregation

