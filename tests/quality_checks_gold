/*
======================================================================================================
Quality Checks
======================================================================================================
Purpose:
    This script performs the quality heck to validatethe integrity, consistency, and accuracy if the gold layer. 
    These checks ensures that :
      - Uniqueness of surrogate keys
      - Referential integrity between fact and dimension tables.
      - Validation of relationships n the data model for analytical purposes.

usage:
      - Run these checks after loading silver layer
      - Investigate and resolve any discrepancies found during the checks.
=======================================================================================================
*/

--=====================================================================================================
Quality Check for 'gold.dim_customers'
--=====================================================================================================
-- Check for uniquness of customer key in gold.dim_customers
-- Expectations: No Results
SELECT 
	customer_key,
	COUNT(*) AS duplicate_counts
FROM 
	gold.dim_customer
GROUP BY 
	customer_key
HAVING 
	COUNT(*) > 1;

--=====================================================================================================
Quality Check for 'gold.dim_products'
--=====================================================================================================
-- Check for uniqueness of product key in gold.dim_products
-- Expectations: No Results
SELECT 
	product_key,
	COUNT(*) AS duplicate_counts
FROM gold.dim_products
GROUP BY 
	product_key
HAVING COUNT(*) > 1; 

--=====================================================================================================
Quality Check for 'gold.fact_sales'
--=====================================================================================================
-- Check the data model connectivity between fact and dimension tables
SELECT *
FROM 
    gold.fact_sales fs
LEFT JOIN 
    gold.dim_customer dc
ON 
    dc.customer_key = fs.customer_key
LEFT JOIN 
    gold.dim_products dp
ON 
    dp.product_key = fs.product_key
WHERE 
    dp.product_key IS NULL OR dc.customer_key IS NULL
